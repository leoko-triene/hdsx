APP_NAME=AI教育智能体
APP_ENV=development
APP_DEBUG=true
SERVE_FRONTEND=false
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_education
MYSQL_USER=ai_education_app
MYSQL_PASSWORD=change_me
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=edu_chunks_dev

# ============================================================================
# 模型服务配置
# 支持 LLM provider: ollama | openai_compatible
# 支持 Embedding provider: ollama | openai_compatible
# openai_compatible 可兼容 OpenAI、DeepSeek、阿里云百炼、智谱等。
# ============================================================================

# ---- 方案 A：本地 Ollama（默认） ----
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen2.5:latest

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_DIMENSION=768

# ---- 方案 B：DeepSeek ----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL=deepseek-chat
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://api.deepseek.com/v1
# EMBEDDING_API_KEY=your-deepseek-api-key
# EMBEDDING_MODEL=???
# EMBEDDING_DIMENSION=???

# ---- 方案 C：OpenAI ----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your-openai-api-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ---- 方案 D：阿里云百炼（DashScope） ----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=your-dashscope-api-key
# LLM_MODEL=qwen-max
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=your-dashscope-api-key
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSION=1024

# ---- 方案 E：智谱 AI ----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=your-zhipu-api-key
# LLM_MODEL=glm-4-flash
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=your-zhipu-api-key
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSION=2048

# 旧 Ollama 配置（兼容用），当上方 LLM_MODEL/EMBEDDING_MODEL 为空时回退到此处
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

RERANKER_MODEL_PATH=<path-to-bge-reranker-v2-m3>
RERANKER_DEVICE=cpu

STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50
RAG_CHUNK_SIZE=650
RAG_CHUNK_OVERLAP=100
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_RERANK_TOP_K=8
